[package]
name = "forensic_hooks"
version = "0.1.0"
edition = "2021"
resolver = "2"

# make the library target explicit so the bin can import it as `forensic_hooks::...`
[lib]
name = "forensic_hooks"
path = "src/lib.rs"

[[bin]]
name = "capture_linux_rotating"
path = "src/bin/capture_linux_rotating.rs"

[[bin]]
name = "edr_attach_any"
path = "src/bin/edr_attach_any.rs"

[[bin]]
name = "validate_playbooks"
path = "src/bin/validate_playbooks.rs"

[[bin]]
name = "extract_evidence"
path = "src/bin/extract_evidence.rs"

[[bin]]
name = "ui_server"
path = "src/bin/ui_server.rs"

[features]
default = []
embed_bpf = []
ebpf = []
ebpf_aya = []  # Use Aya eBPF framework (default for Linux)
ebpf_libbpf = []  # Use libbpf-rs eBPF framework (alternative backend)
with-ebpf = []
with-ebpf-load = []
gnn = []  # GNN hooks and graph infrastructure (disabled by default)
windows_etw = []  # Windows ETW collection (requires elevation; disabled by default)
forensic = []  # Advanced endpoint forensics (ebpf, modules, file/process monitoring)
advanced_scoring = []  # Optional scoring pipelines (yara, elastic, ecs, explain)

[dependencies]
# --- web / http ---
axum = "0.7"
tower-http = { version = "0.5", features = ["cors", "fs", "set-header"] }
tokio = { version = "1", features = ["rt-multi-thread", "macros", "sync", "signal", "time"] }
futures = "0.3"
futures-util = "0.3.31"
hyper = "1"

# ❗️REMOVED the bad self-dependency:
# forensic_hooks = { path = "../forensic_hooks" }

# --- serde / json ---
serde = { version = "1.0", features = ["derive"] }
serde_json = "1"
uuid = { version = "1", features = ["v4", "serde"] }
rusqlite = { version = "0.29", features = ["bundled", "chrono", "uuid"] }

# --- logging ---
log = "0.4.27"
env_logger = "0.11"
parking_lot = "0.12"
tokio-stream = { version = "0.1", features = ["sync"] }
serde_yaml = "0.9"

# --- time / utils ---
chrono = { version = "0.4", features = ["serde"] }
regex = "1"
once_cell = "1.19.0"
bytes = "1.6"
rand = "0.8"
walkdir = "2"
lazy_static = "1.4"
flume = "0.11"
# --- crypto / hashing ---
ed25519-dalek = "1.0"
hmac = "0.12"
sha1 = "0.10"
sha2 = "0.10"
sha3 = "0.10"
base64 = "0.21"
openssl = "0.10"

# --- file/sys/comp ---
flate2 = "1"
fs2 = "0.4"
mime_guess = "2.0"
users = "0.11"
sysinfo = "0.29"
hostname = "0.3"
dirs = "6.0.0"
libc = "0.2"
nix = { version = "0.30.1", features = ["uio", "process"] }

# --- math / stats / geom ---
nalgebra = { version = "0.32", default-features = false, features = ["std"] }
num-traits = "0.2.19"
geo = "0.30.0"

# --- misc ---
anyhow = "1.0"
hex = "0.4"
glob = "0.3.2"
entropy = "0.4"
reqwest = { version = "0.11", features = ["blocking", "json", "rustls-tls"] }
bincode = { version = "2.0.1", features = ["derive"] }
tracing = "0.1.41"
tdigest = "0.2.3"
ctrlc = "3.4"

# eBPF stacks (Linux only)
# Default: Aya framework (modern, async-friendly)
# Optional: libbpf-rs feature for alternative backend
[target.'cfg(target_os = "windows")'.dependencies]
windows = { version = "0.54", features = [
    "Win32_System_EventLog",
    "Win32_System_Memory",
    "Win32_Foundation",
] }

[target.'cfg(target_os = "linux")'.dependencies]
aya = { version = "0.13.1", features = ["async_tokio"] }
aya-log = "0.2.1"
libbpf-rs = { version = "0.21", optional = true }
netlink-sys = "0.6"

[profile.release]
lto = "thin"
codegen-units = 1
panic = "abort"
# ❗️REMOVED invalid key `statrs = "0.16"` from [profile.release]
